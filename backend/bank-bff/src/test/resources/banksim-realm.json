{
  "realm": "banksim",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": { "realm": [ { "name": "klant" }, { "name": "admin" } ] },
  "clients": [
    {
      "clientId": "bank-bff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["*"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "*" },
      "protocolMappers": [
        {
          "name": "realmrollen in ID-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true",
                      "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "false" }
        },
        {
          "name": "audience bank-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "bank-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ],
      "defaultClientScopes": ["basic", "profile", "roles", "acr"]
    }
  ],
  "users": [
    {
      "username": "jdevries", "enabled": true, "firstName": "Jan", "lastName": "de Vries",
      "email": "jdevries@banksim.local", "emailVerified": true, "realmRoles": ["klant"],
      "credentials": [ { "type": "password", "value": "klant-wachtwoord", "temporary": false } ]
    },
    {
      "username": "beheerder", "enabled": true, "firstName": "BankSim", "lastName": "Beheerder",
      "email": "beheerder@banksim.local", "emailVerified": true, "realmRoles": ["admin"],
      "credentials": [ { "type": "password", "value": "beheer-wachtwoord", "temporary": false } ]
    }
  ]
}
